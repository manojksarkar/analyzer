          ]
        },
        "Support": {
          "Math": "Math",
          "App": "App",
          "Outer": "Outer/Inner"
        },
        "Access": {
          "Access": "Access"
        },
        "Signal": {
          "Signal": "Signal"
        },
        "Diag": {
          "Diag": "Diag"
        }
      }
    },
    "Layer2": {
      "path": "Layer2",
      "cores": [
        "Core2"
      ],
      "groups": {
        "My Sample": {
          "Sample Core": "Sample/Core",
          "Lib": "Sample/Lib"
        },
        "Platform": {
          "Gpio": "Platform/Gpio",
          "Uart": "Platform/Uart",
          "Spi": "Platform/Spi",
