  "llm": {
    "descriptions": true,
    "behaviourNames": true,
    "summarize": true,
    "fewShotExamplesDir": "few_shot_examples",
    "abbreviationsPath": "engine/config/abbreviations.txt",
    "domainContextPath": "engine/config/domain.txt",
    "descriptionBlocklist": [
      "audio",
      "video"
    ],
    "cacheVersion": 2,
    "enrichment": {
      "twoPassDescriptions": false,
      "selfReview": false,
      "ensemble": false,
      "cfgSimplification": false,
      "variableEnrichment": false
    }
  },
  "ui": {
    "theme": "Light"
  },
  "logs": {
    "liveLines": 500,
    "maxLines": 2000,
    "level": "INFO",
    "keepDays": 30
  },
  "docx": {
    "introduction": {
      "purpose": "This document provides the Software Detailed Design (SDD) for the {project_name} software. It describes the internal structure, interfaces, and behaviour of each software component. The document is intended for software engineers responsible for implementation and verification of the {project_name} system.",
      "scopeIntro": "This document covers the software detailed design for the {project_name} system. The following component/s are within the scope of this document:",
      "scopeBody": "For each component, this document provides the following:",
      "scopeItems": [
        "Component Name",
        "Static Design (Component, units, global variables)",
        "Unit Information",
        "Unit Name",
        "Static Design"
      ]
    },
    "swe4": {
      "evalEquipmentName": "Emulator",
      "testPlatform": "VectorCAST",
      "testEnvironment": "Emulator",
      "priorityDefault": "Medium",
      "introduction": {
        "purpose": "This document provides the Software Unit Test Specification for the {project_name} software. It specifies, for each software unit, the preconditions, inputs, test steps and expected results required to verify the unit against its detailed design.",
        "scopeIntro": "This document covers the unit test specifications for the following components of the {project_name} software:",
        "scopeBody": "Each public function is specified by two tables: Table A carries the test content (Eval. Equipment Name, Precondition, Input, Test Steps, Expected Results, Test Platform) and Table B carries the test case metadata."
      }
    }
  }
