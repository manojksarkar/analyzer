{
  "project": {
    "name": "SampleCppProject",
    "repository": "",
    "branch": "main"
  },
  "clang": {
    "clangArgs": [
      "--target=arm-none-eabi"
    ],
    "includePathsFromProjectWalk": false
  },
  "views": {
    "interfaceTables": true,
    "unitHeaders": true,
    "unitDiagrams": true,
