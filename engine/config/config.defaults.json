    },
    "Core2": {
      "dataDictionary": "engine/config/data_dictionary.core2.example.csv",
      "macros": "engine/config/macros.core2.example.json",
      "compileCommands": "engine/config/compile_commands.core2.example.json"
    }
  },
  "layers": {
    "Layer1": {
