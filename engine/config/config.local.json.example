{
  // THIS SERVER's settings: its database, its sign-in, its repository folders, its LLM server,
  // its LLVM install, its speed-ups and its job scheduling. Copy this file to `config.local.json`
  // (same folder) and fill in real values. `config.local.json` is gitignored, so credentials never
  // get committed.
  //
  // One file per kind of setting:
  //
  //   config.local.json     THIS SERVER              db, auth, repositories, llmServer, llvm, speedups, jobs
  //   config.defaults.json  HOW DOCUMENTS ARE MADE   clang, views, llm, docx, cores, layers, ...
  //
  // The seven blocks below are read from THIS file only. They are not in config.defaults.json, a
  // project's own config cannot set them, and a version does not store them. Change one here and
  // the next run uses it: every project, from the web app and from `analyzer.py` alike.

  // Database connection. Used by the API server and the db tools when DATABASE_URL is NOT set
  // in the environment (env var still wins if present). Resolution order:
  //   DATABASE_URL env  ->  this `db` section  ->  the compose default (localhost).
  "db": {
    "driver": "postgresql+psycopg",
    "host": "127.0.0.1",
    "port": 5432,
    "user": "analyzer",
    "password": "analyzer",
    "database": "analyzer"
  },

  // How long a sign-in to the API lasts, in minutes (default 480, a working day). After it, every
  // request answers 401 "Signature has expired" and Swagger needs a fresh token; the web app
  // renews by itself. Read by the API server at start-up — restart it after a change.
  "auth": {
    "accessTokenMinutes": 480
  },

  // Local repositories: the New Project wizard takes a Git URL or a LOCAL PATH -- a git
  // repository's folder on this server, typed or picked in its Browse panel. `localRoots` limits
  // both to these folders (and their subfolders): the panel starts at them and cannot go above,
  // and a path outside them is refused. Empty or absent: every drive of the server, and any
  // signed-in user may list its folder names -- set it on a shared server. Read on every
  // request: no restart needed.
  "repositories": {
    "localRoots": ["D:/src"]
  },

  // The LLM server: which one answers, how to sign in to it, and what it can take.
  //
  // `provider`, `baseUrl` and `defaultModel` are required by every run that writes LLM text.
  // Without this block only `--no-llm` runs work: any other run stops at its start and says so.
  //
  // WHAT the LLM writes (descriptions, names, the prompt inputs) is not a server setting: that is
  // `llm` in config.defaults.json, and each project's own switches.
  "llmServer": {
    "provider": "openai",                      // "openai" (any OpenAI-shaped gateway), "ollama" or "anthropic"
    "baseUrl": "https://your-llm-gateway/v1",
    "defaultModel": "your-model-name",

    // Sent with every request. The ticket is the secret.
    "customHeaders": {
      "x-dep-ticket": "credential:YOUR_TOKEN_HERE",
      "User-Type": "AD_ID",
      "User-Id": "your-user-id",
      "Send-System-Name": "rvc-api-module"
    },
    // "apiKey": "YOUR_KEY_HERE",              // only for a server that takes "Authorization: Bearer"

    // Everything below may be left out; the values shown are what a run uses then.

    // ---- One call ----
    "timeoutSeconds": 300,                     // how long one call may take
    "retries": 1,                              // tries again after a failed call
    "numCtx": 8192,                            // context window in tokens (sent to Ollama only)
    "maxContextTokens": 127488,                // prompt budget in tokens; null = worked out from provider and numCtx

    "rateLimitSeconds": 3                      // the pause after each call (on ONE ticket); 0 = no pause
  },

  // A local Ollama instead of a gateway:
  //   "llmServer": { "provider": "ollama", "baseUrl": "http://localhost:11434", "defaultModel": "llama3.2" }
  //
  // The Claude API (Anthropic's Messages API) instead of a gateway:
  //   "llmServer": { "provider": "anthropic", "baseUrl": "https://api.anthropic.com",
  //                  "defaultModel": "claude-sonnet-5-5", "apiKey": "sk-ant-...", "rateLimitSeconds": 0 }
  // The key is read from THIS file only -- no environment variable (not even LLM_API_KEY or
  // LLM_API_KEYS), so a gateway key set there never goes to the Claude API. customHeaders are sent
  // as they are (for a proxy in front of the API); none of the gateway's defaults. More keys side
  // by side: speedups.llms, { "name": ..., "apiKey": ... } each. Check it with
  //   python analyzer.py check-llm --only tiny     -- the source code in the prompts goes to the API.
  //
  // One run on other values, without editing this file -- environment variables:
  //   LLM_PROVIDER, LLM_BASE_URL, LLM_DEFAULT_MODEL, LLM_API_KEY, LLM_RATE_LIMIT_SECONDS,
  //   LLM_TIMEOUT_SECONDS, LLM_RETRIES, LLM_NUM_CTX

  // Where LLVM is installed on this machine.
  //   libPath      the libclang library the parser loads
  //   includePath  Clang's own headers (stddef.h, stdint.h, ...): the folder of the installed version
  // Without this block the parser uses the libclang that came with `pip install libclang`, and
  // says so in the run's log.
  //
  // The FLAGS every parse is given (clang.clangArgs) are not a machine setting: they are in
  // config.defaults.json, and a project may set its own.
  "llvm": {
    "libPath": "C:\\Program Files\\LLVM\\bin\\libclang.dll",
    "includePath": "C:\\Program Files\\LLVM\\lib\\clang\\17\\include"
  },

  // This branch's speed-ups (docs/design/PIPELINE_SPEED_PLAN.md), all of them here. Each one as
  // written is develop's way: copied as it is, a server runs exactly as develop does. Change a key
  // to use that speed-up. None of them changes a document. A run's log says at its start which it
  // uses ("Speed-ups: ...").
  "speedups": {
    // More tickets or keys for the LLM server above, side by side. [] = llmServer's own ticket,
    // one call at a time (develop's). A lane takes the fields it does not set from llmServer, has
    // a `name` for the log (never a secret) and its own credential. When llms are listed, only
    // they send calls: llmServer's ticket is then the default of a lane that names none.
    //   "llms": [
    //     { "name": "ticket-a", "customHeaders": { "x-dep-ticket": "credential:TOKEN_A" } },
    //     { "name": "ticket-b", "customHeaders": { "x-dep-ticket": "credential:TOKEN_B" } }
    //   ]
    // Other lanes:
    //   a second user's ticket    { "name": "user2", "customHeaders": { "User-Id": "user-id-2", "x-dep-ticket": "credential:TOKEN_2" } }
    //   an API key, not a header  { "name": "key-a", "apiKey": "KEY_A" }   (or env LLM_API_KEYS=KEY_A,KEY_B and no llms)
    //   another gateway           { "name": "backup", "baseUrl": "https://other-gateway/v1", "apiKey": "KEY_C" }
    //   two calls at once on it   add "maxConcurrent": 2 to the lane
    // The environment's X_DEP_TICKET, USER_ID, USER_TYPE and SEND_SYSTEM_NAME replace that header
    // on EVERY lane. Before a long run:  python analyzer.py check-llm --only tiny  asks every lane.
    "llms": [],

    // Where llmServer.rateLimitSeconds is counted from: "after" the END of a call (develop's), or
    // "start" -- faster (with a 5 s answer, a call every 5 s instead of every 8), but right only
    // if the gateway counts so.
    "pacing": "after",

    // Files parsed at once (Phase 1): 1 (develop's), a number, or "auto" = half the CPUs, at most
    // 8. Each file parsed ahead holds its whole AST in memory: 2-4 on an 8 GB machine, 6-8 on 16 GB
    // and up. The environment's ANALYZER_PARSE_WORKERS wins.
    "parseWorkers": 1,

    // true: a view's pictures drawn by one browser instead of one each -- about 5 times faster; a
    // picture the batch misses is drawn alone. false: each alone (develop's).
    "pictureBatches": false,

    // true: the parser checks for libclang's empty cursor itself instead of with a second libclang
    // call -- Phase 1 about a quarter faster; it stays off by itself where the bindings disagree.
    // false: the bindings' own check (develop's).
    "fastNullCheck": false
  },

  // Job scheduling (docs/spec/JOB_SCHEDULING_SPEC.md): read by the API at start-up -- restart it
  // after a change -- and by `analyzer.py` at each run. Each key left out keeps the value shown.
  "jobs": {
    // Generations (generate, export, resume) running at once on this server, all projects
    // together -- a whole number. A paused one does not count; Word-file updates have no cap.
    "maxGenerations": 2,
    // false: after a restart, waiting jobs are held until a super admin starts or clears them.
    // true: they start by themselves.
    "startQueuedAfterRestart": false,
    // A job paused this many days is cancelled -- a version that never finished is deleted.
    // Parts of a day too: 0.003 is about four minutes, for a test server.
    "pausedDays": 7,
    // A running job silent this many minutes is interrupted, and the next one starts. At least 2:
    // a running job says it is alive every minute.
    "interruptedAfterMinutes": 10,
    // Ended jobs' records are kept this many days -- each version's own generation job longer.
    // Looked at once a day, or every keepFinishedDays when shorter (0.002: about three minutes).
    "keepFinishedDays": 90
  }
}
